<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Your App Name</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>your_app_name</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	<string>UIInterfaceOrientationPortraitUpsideDown</string>
	<string>UIInterfaceOrientationLandscapeLeft</string>
	<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ⚠️ IMPORTANT: iOS Permission Configuration ⚠️ -->
	<!-- 
	This is a reference file showing ALL available permissions.
	DO NOT copy all of these to your app's Info.plist!
	
	CRITICAL RULES:
	1. Only add usage descriptions for permissions you enabled in ios/Podfile
	2. If you enable a permission in Podfile but don't add its usage description here, Apple will REJECT your app
	3. If you add a usage description here but don't enable it in Podfile, Apple may REJECT your app
	4. Customize the description strings to accurately describe YOUR app's use case
	
	Mapping: Podfile Permission → Required Info.plist Keys
	-->

	<!-- PERMISSION_CAMERA=1 → Requires NSCameraUsageDescription -->
	<key>NSCameraUsageDescription</key>
	<string>This app needs camera access to take photos and videos</string>

	<!-- PERMISSION_PHOTOS=1 → Requires NSPhotoLibraryUsageDescription and NSPhotoLibraryAddUsageDescription -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs access to select photos from the gallery</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>This app needs access to save photos to the gallery</string>

	<!-- PERMISSION_LOCATION=1 → Requires at least NSLocationWhenInUseUsageDescription -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app needs your location to provide location-based services</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>This app needs your location for background activity</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>This app needs your location to provide the best user experience</string>

	<!-- PERMISSION_MICROPHONE=1 → Requires NSMicrophoneUsageDescription -->
	<key>NSMicrophoneUsageDescription</key>
	<string>This app needs microphone access to record audio and video</string>

	<!-- PERMISSION_CONTACTS=1 → Requires NSContactsUsageDescription -->
	<!-- ⚠️ Apple will reject if you don't enable PERMISSION_CONTACTS=1 in Podfile -->
	<key>NSContactsUsageDescription</key>
	<string>This app needs access to contacts to find friends</string>

	<!-- PERMISSION_CALENDAR=1 → Requires NSCalendarsUsageDescription -->
	<key>NSCalendarsUsageDescription</key>
	<string>This app needs access to add events to the calendar</string>

	<!-- PERMISSION_REMINDERS=1 → Requires NSRemindersUsageDescription -->
	<key>NSRemindersUsageDescription</key>
	<string>This app needs access to create reminders</string>

	<!-- PERMISSION_MOTION=1 → Requires NSMotionUsageDescription -->
	<!-- ⚠️ Apple will reject if you don't enable PERMISSION_MOTION=1 in Podfile -->
	<key>NSMotionUsageDescription</key>
	<string>This app needs access to motion sensors to track physical activity</string>

	<!-- PERMISSION_BLUETOOTH=1 → Requires NSBluetoothAlwaysUsageDescription -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>This app needs access to connect to Bluetooth devices</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>This app needs access to work as a Bluetooth peripheral device</string>

	<!-- PERMISSION_HEALTH=1 → Requires NSHealthShareUsageDescription and NSHealthUpdateUsageDescription -->
	<!-- ⚠️ Apple will reject if you don't enable PERMISSION_HEALTH=1 in Podfile -->
	<key>NSHealthShareUsageDescription</key>
	<string>This app needs access to read your health data</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>This app needs access to update your health data</string>

	<!-- PERMISSION_SPEECH_RECOGNITION=1 → Requires NSSpeechRecognitionUsageDescription -->
	<!-- ⚠️ Apple will reject if you don't enable PERMISSION_SPEECH_RECOGNITION=1 in Podfile -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>This app needs access to convert speech to text</string>

	<!-- PERMISSION_MUSIC_LIBRARY=1 → Requires NSAppleMusicUsageDescription -->
	<key>NSAppleMusicUsageDescription</key>
	<string>This app needs access to Apple Music and music library</string>

	<!-- Face ID (Optional - not controlled by Podfile) -->
	<key>NSFaceIDUsageDescription</key>
	<string>This app needs access for secure authentication with Face ID</string>

</dict>
</plist>